APP_ENV=development

# MYSQL Database Configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=YOUR_DB_NAME_HERE
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DB

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY_HERE
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY_HERE
MINIO_BUCKET=YOUR_MINIO_BUCKET_NAME_HERE

SECRET_KEY = YOUR_SECRET_KEY_HERE
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 30

# LLM Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=stepfun/step-3.5-flash:free
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_HTTP_REFERER=http://localhost:8000
LLM_X_TITLE=Chatbot App

# Reset Password Email Configuration
FRONTEND_URL=http://localhost:3000
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL_ADDRESS
SMTP_PASSWORD=YOUR_EMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=YOUR_EMAIL_ADDRESS
SMTP_FROM_NAME=Chatbox
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Chatbot Limits
CHAT_MAX_USER_MESSAGE_LENGTH=2000
CHAT_MAX_CONVERSATIONS_PER_USER=50
CHAT_MAX_MESSAGES_PER_CONVERSATION=100
CHAT_MAX_HISTORY_MESSAGES_FOR_MODEL=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_REQUESTS_PER_WINDOW=10
